<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingTop="?attr/actionBarSize" >

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/nav_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="0dp"
        android:background="?android:attr/windowBackground"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:menu="@menu/bottom_nav_menu"/>

    <fragment
        android:id="@+id/nav_host_fragment_activity_main"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:defaultNavHost="true"
        app:layout_constraintBottom_toTopOf="@id/nav_view"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navGraph="@navigation/mobile_navigation"
    />

    <TextView
        android:id="@+id/textView"
        android:layout_width="91dp"
        android:layout_height="57dp"
        android:layout_marginStart="30dp"
        android:layout_marginTop="10dp"
        android:autoSizeTextType="uniform"
        android:autoText="false"
        android:duplicateParentState="true"
        android:visibility="visible"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Scrap"
        tools:visibility="visible" />

    <EditText
        android:id="@+id/editTextNumberDecimal"
        android:layout_width="209dp"
        android:layout_height="58dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="8dp"
        android:accessibilityHeading="false"
        android:accessibilityLiveRegion="none"
        android:accessibilityPaneTitle="Cost per 100"
        android:accessibilityTraversalAfter="@id/textView"
        android:accessibilityTraversalBefore="@id/editTextNumberDecimal2"
        android:allowClickWhenDisabled="true"
        android:autoText="false"
        android:autofillHints="Cost per 100"
        android:ems="10"
        android:importantForAccessibility="auto"
        android:inputType="numberDecimal"
        android:labelFor="@id/editTextNumberDecimal2"
        app:layout_constraintStart_toEndOf="@+id/textView"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="4.93" />

    <TextView
        android:id="@+id/textView1"
        android:layout_width="91dp"
        android:layout_height="57dp"
        android:layout_marginStart="30dp"
        android:autoSizeTextType="uniform"
        android:autoText="true"
        android:duplicateParentState="true"
        android:visibility="visible"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView"
        tools:text="Copper"
        tools:visibility="visible" />

    <EditText
        android:id="@+id/editTextNumberDecimal2"
        android:layout_width="208dp"
        android:layout_height="56dp"
        android:layout_marginStart="141dp"
        android:accessibilityHeading="false"
        android:accessibilityLiveRegion="none"
        android:accessibilityPaneTitle="Cost per 100"
        android:accessibilityTraversalAfter="@id/editTextNumberDecimal"
        android:accessibilityTraversalBefore="@id/textView"
        android:autofillHints="Cost per 100"
        android:ems="10"
        android:importantForAccessibility="auto"
        android:inputType="numberDecimal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/editTextNumberDecimal"
        tools:text="7.01" />

</androidx.constraintlayout.widget.ConstraintLayout>